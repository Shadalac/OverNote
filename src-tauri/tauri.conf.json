{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverNote",
  "version": "0.1.4",
  "identifier": "com.shadow.notesapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "(OverNote_)",
        "width": 900,
        "height": 640,
        "minWidth": 500,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNzQ2QzlBMUZGQUU3RApSV1I5cnYraHlVWVhEeXZTUXRLUXBhTzljalBXVlF3Y0tTcjRVYnNCRDY0YzdrWCthaXVLaG0vLwo=",
      "endpoints": [
        "https://github.com/Shadalac/OverNote/releases/latest/download/latest.json"
      ]
    }
  }
}
